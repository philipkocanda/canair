.Trashes
Icon
Icon?
Icon\r
ehthumbs.db
Thumbs.db

# Python
__pycache__/
.venv/
dist/
*.egg-info/

# Tooling caches and coverage artifacts (machine-local, never shared)
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# NodeJS
node_modules

# Docs site build output, and the files that scripts/docs_site/data.py generates into docs/
site/
/docs/assets/explorer/data/
/docs/schema/

# Project-specific
wican-fw/
logs/
docs-ignored/
archive/
css-electronics/
# Fetched third-party CAN corpora (fetch-on-demand; never committed — see
# scripts/fetch/fetch_can_corpus.py and plans/2026-07-24-raw-can-analysis.md)
/references/

# Secrets and local config
.env
.secrets.json
config.yaml

# ELM327-Emulator writes a log file to the cwd during offline testing (and
# rotates it to elm.log.1, elm.log.2, …)
elm.log*

# Per-profile logs (command/response captures) and generated build output
profiles/*/logs/

# Legacy location of the DTC log (now user state, ~/.config/canair/dtc_log/); an older
# canair may still write it here until the next run moves it
profiles/*/dtc_log.yaml

# Capture journals — write-ahead logs, reconciled into captures/*.json on exit
profiles/*/captures/.journal/

# Blind-rediscovery eval sandboxes, answer keys, and reports (on-demand tooling
# stress-test — see scripts/research/blind_rediscovery.py and src/canair/blind.py). Contains
# held-out ground truth; never committed.
/rediscovery/
