# ELM327-Emulator writes a log file to the cwd during offline testing (and
# rotates it to elm.log.1, elm.log.2, …)
elm.log*

# Per-profile logs (command/response captures) and generated build output
profiles/*/logs/

# Per-vehicle DTC scan history — runtime state, changes every scan, not shared
profiles/*/dtc_log.yaml

# Capture journals — write-ahead logs, reconciled into captures/*.json on exit
profiles/*/captures/.journal/

# Blind-rediscovery eval sandboxes, answer keys, and reports (on-demand tooling
# stress-test — see scripts/blind_rediscovery.py and canlib/blind.py). Contains
# held-out ground truth; never committed.
/rediscovery/
