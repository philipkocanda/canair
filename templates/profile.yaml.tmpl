$schema_modeline
# $car_model — vehicle profile settings (created by `canair profile create`)
#
# Profile-wide settings. Only car_model and init are required; each commented block below is
# optional, with its default stated. Field reference: docs/concepts/profiles.md ("profile.yaml
# settings"); check the file with `canair validate`.
#
# Next: register the car's ECUs in ecus/ with `canair discover --register` (or offline with
# `canair ecu add`), declare its variants with `canair variants add` if it comes in several
# versions, then define PIDs with `canair pids …`.
car_model: "$car_model"

# ELM327 init string, sent by the ELM327 transports (wican-ws, elm327-tcp); slcan-tcp ignores
# it. ATSP6 is ISO 15765-4 CAN, 11-bit, 500 kbit/s (ATSP7: 29-bit 500k, ATSP8: 11-bit 250k,
# ATSP9: 29-bit 250k). Leave ATSH, ATCRA, ATFCSH, ATFCSD and ATFCSM out: canair sets the header,
# receive filter and flow control per ECU from `addressing`.
init: "$init"

# ELM327 response timeout in ms, applied as ATSTxx after init (--elm-timeout overrides). Raise
# it for slow ECUs (the Ioniq Electric needs 614); lower it to speed up NO DATA detection. Unset,
# the adapter's default applies.
# response_timeout_ms: 614

# Bus speed in bit/s for the raw slcan-tcp transport and `canair sniff` (an ELM327 takes its
# speed from the ATSP protocol in init). Set it when the diagnostic bus isn't 500 kbit/s.
# Precedence: the device's config entry / transport.bitrate > this > the WiCAN's own setting >
# 500000.
# can_bitrate: 250000

# CAN diagnostic addressing. The default, normal_11bit, answers each request on tx_id + 0x08
# (0x7E0 -> 0x7E8, the ISO 15765-4 convention). Set rx_offset for a make with another fixed
# offset (XPeng 0x80: 0x704 -> 0x784; negative is allowed), or mode for 29-bit or extended
# addressing (normal_29bit, normal_fixed_29bit, normal_extended_11bit, extended_29bit). One
# irregular ECU overrides it in its own ecus/ file (rx_id, addressing).
# addressing:
#   mode: normal_11bit
#   rx_offset: 0x08

# Client-side ISO-TP tuning for the slcan-tcp transport. The defaults suit most 11-bit classic
# CAN cars; every field and default is in canlib/transport/isotp_params.py.
# isotp:
#   tx_padding: 0xAA   # byte canair pads its requests with (default 0xAA)
#   rx_padding: 0xAA   # byte the ECUs pad replies with (default: tx_padding)
#   can_fd: false      # true for CAN-FD ECUs

# Make-specific behaviour this profile opts into; a make-neutral profile omits it. Known:
# hk_f1xx_minus_one (Hyundai/Kia identity DIDs answer one less than requested: 22F188 ->
# 62F187), hk_90_session, hk_forced_sleep and skm_wakeup (Hyundai/Kia), nissan_c0_session
# (Nissan). Each is described in docs/concepts/profiles.md.
# quirks:
#   - hk_f1xx_minus_one

# UDS service-22 multi-DID batching (several DIDs in one request) is off unless enabled here or
# with an ECU's own `multi_did:`; an ECU that refuses it falls back to single reads.
# multi_did_max caps the DIDs per request (default 3; an ECU may override it).
# multi_did_batching: true
# multi_did_max: 3

# Physical-value bands for the reference-free scan (`canair hunt --physical` /
# `canair investigate`). A name matching a built-in (hv_pack, rail_12v) replaces its
# [low, high]; any other name adds a band. The built-in hv_pack is a ~400 V pack (300-450 V):
# for another pack take its series cell count N, from N x 2.5 V (empty) to N x 4.2 V (full) for
# a lithium-ion NMC pack. Grid bands come from the user's `grid_region` config, not from here.
# physical_bands:
#   hv_pack: [450, 820]   # e.g. an 800 V pack (192S)
